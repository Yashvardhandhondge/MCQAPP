{
  "expo": {
    "name": "MHT CET Saarthi PYQ",
    "slug": "mcqapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-logo.png",
    "scheme": "mcqfrontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mcqfrontend.app"
    },
    "android": {
      "package": "com.mcqfrontend.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#1a3a5c",
        "foregroundImage": "./assets/images/app-logo.png",
        "backgroundImage": "./assets/images/app-logo.png",
        "monochromeImage": "./assets/images/app-logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/app-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/app-logo.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#1a3a5c",
          "dark": {
            "backgroundColor": "#1a3a5c"
          }
        }
      ],
      [
        "onesignal-expo-plugin",
        {
          "mode": "development"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b082ddd3-a196-45ea-8adf-4cd3827dc1f5"
      },
      "oneSignalAppId": "7a811e86-9a98-4206-abbf-46d38aceb027"
    },
    "owner": "yashvardhandhondge"
  }
}
